{
  "name": "dev-cli-kit",
  "version": "0.1.0",
  "description": "A modern CLI toolkit for developers - project scaffolding, code generation, and workflow automation",
  "keywords": [
    "cli",
    "developer-tools",
    "scaffolding",
    "code-generation",
    "productivity"
  ],
  "license": "MIT",
  "author": "GrahamduesCN",
  "repository": {
