    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.0.0",
    "vitest": "^1.0.0",
    "@types/node": "^20.0.0"
  },
  "bin": {
    "dev-cli-kit": "./dist/cli.js"
  }
